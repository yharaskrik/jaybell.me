{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "master",
    "namedInputs": {
        "sharedGlobals": [],
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": ["default"]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build", "css"],
            "inputs": ["production", "^production"]
        },
        "css": {
            "cache": true,
            "inputs": ["{projectRoot}/styles/**/*"],
            "outputs": ["{projectRoot}/gen"]
        }
    },
    "analytics": false
}
