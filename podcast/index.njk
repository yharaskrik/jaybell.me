---
layout: base.njk
title: Podcasts
description: All of my podcast episodes and videos - The Angular Plus Show and more, across Spotify, YouTube, and others.
eleventyNavigation:
    key: Podcasts
    order: 4
---

<section class="py-14 pb-[72px]">
    <div class="animate-rise">
        <h1 class="mb-3 font-display text-[clamp(30px,5vw,42px)] tracking-tight text-ink">Podcasts</h1>
        <p class="mb-10 max-w-[560px] text-base leading-[1.65] text-ink2">
            Every episode and video I'm a part of, all in one place - labeled by where you can watch or listen.
        </p>
    </div>

    {% set videos = advocu_activities | gdeVideos %}
    {% if videos.length %}
        <div class="flex flex-col border-t border-line">
            {% for item in videos %}
                <article class="group grid grid-cols-[120px_1fr] items-baseline gap-6 border-b border-line py-[22px] max-sm:grid-cols-1 max-sm:gap-1.5 transition-[background,border-color] duration-150 hover:bg-surface2 hover:border-ink3 max-sm:px-3 max-sm:-mx-3" data-reveal>
                    <time class="font-mono text-[11px] text-ink3" datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
                    <div>
                        <a class="font-display text-xl text-ink no-underline hover:text-accent" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
                        {% if item.description %}
                            <p class="mt-1.5 text-[13px] leading-[1.55] text-ink2">{{ item.description }}</p>
                        {% endif %}
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                            {% if item.platform %}
                                <a class="pill text-[9px] no-underline" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.platform }}</a>
                            {% endif %}
                            {% for tag in item.tags | head(4) %}
                                <span class="pill text-[9px]">{{ tag }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p>No episodes yet. New episodes, streams, and talks land here as they go out.</p>
    {% endif %}
</section>
