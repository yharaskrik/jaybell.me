---
layout: base.njk
title: Blog
description: Posts from Jay Bell on Angular, Nx, open source, startups, and more.
eleventyNavigation:
    key: Blog
    order: 2
---

<section class="page">
    <h1 class="page-title">Blog</h1>
    <p class="page-lead">Posts on Angular, Nx, open source, startups, and more.</p>

    {% set postslist = collections.posts %}
    {% if postslist.length %}
        <div class="post-list">
            {% for post in postslist %}
                <article class="post-list__item">
                    <time class="post-list__date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
                    <a class="post-list__link" href="{{ post.url }}">{{ post.data.title }}</a>
                    {% if post.data.description %}
                        <p class="post-list__description">{{ post.data.description }}</p>
                    {% endif %}
                    {% if post.data.tags %}
                        <div class="post-list__tags">
                            {% for tag in post.data.tags | filterTagList %}
                                <span class="tag">#{{ tag }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p>No posts yet — check back soon!</p>
    {% endif %}
</section>
