---
layout: base.njk
---

<article class="post">
    <header class="post__header">
        <p class="post__meta">
            <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
            {% if author %}
                · {{ author }}
            {% endif %}
        </p>
        <h1 class="post__title">{{ title }}</h1>
        {% if description %}
            <p class="post__description">{{ description }}</p>
        {% endif %}
    </header>

    <div class="prose-jay">{{ content | safe }}</div>

    {% if tags %}
        <div class="post-list__tags">
            {% for tag in tags | filterTagList %}
                <span class="tag">#{{ tag }}</span>
            {% endfor %}
        </div>
    {% endif %}

    <nav class="post__nav">
        {% if page.previous %}
            <a href="{{ page.previous.url }}">← {{ page.previous.data.title }}</a>
        {% endif %}
        {% if page.next %}
            <a href="{{ page.next.url }}">{{ page.next.data.title }} →</a>
        {% endif %}
    </nav>
</article>
