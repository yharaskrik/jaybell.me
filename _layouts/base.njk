<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#121116" media="(prefers-color-scheme: dark)" />
        <title>
            {% set isHome = page.url == '/' %}
            {% set pageTitle = title or (eleventyNavigation and (eleventyNavigation.title or eleventyNavigation.key)) %}
            {% if isHome %}
                {{ site.title }}
            {% elseif pageTitle %}
                {{ pageTitle }} - {{ site.title }}
            {% else %}
                {{ site.title }}
            {% endif %}
        </title>
        <meta name="description" content="{{ description or site.description }}" />
        <meta property="og:title" content="{% if isHome %}{{ site.title }}{% elseif pageTitle %}{{ pageTitle }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}" />
        <meta property="og:description" content="{{ description or site.description }}" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
        <meta property="og:image" content="{{ site.url }}/assets/images/jay.jpg" />
        <meta name="twitter:card" content="summary" />
        <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ site.title }}" />

        {#- Google Analytics (GA4) #}
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-506R66WVXZ"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', 'G-506R66WVXZ');
        </script>

        {#- Dark mode bootstrap: no flash-of-wrong-theme before the page renders #}
        <script>
            (function () {
                try {
                    document.documentElement.classList.add('js');
                    var stored = localStorage.getItem('theme');
                    var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
                    if (dark) document.documentElement.classList.add('dark');
                } catch (e) {}
            })();
        </script>

        {#- Fonts #}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Audiowide&family=Chakra+Petch:wght@400;500&display=swap"
            rel="stylesheet"
        />

        {#- Styles #}
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/assets/css/prism.css" />

        {#- Favicon #}
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg" />
    </head>
    <body>
        <a
            class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-ink focus:text-surface focus:px-4 focus:py-2 focus:font-mono focus:text-xs"
            href="#main"
            >Skip to main content</a
        >

        <div class="mx-auto max-w-[860px] px-7 max-sm:px-5">
            <header>
                <nav
                    class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-line bg-[color-mix(in_srgb,var(--color-surface)_92%,transparent)] py-[22px] backdrop-blur-md"
                    aria-label="Primary"
                >
                    <a class="font-mono text-[13px] tracking-[0.02em] text-ink2 whitespace-nowrap hover:text-accent" href="/"
                        >jaybell<span class="text-accent">.</span>me</a
                    >
                    <div class="flex items-center gap-6 max-sm:gap-3.5">
                        {%- for entry in collections.all | eleventyNavigation %}
                            <a
                                class="-my-2 py-2 text-[13px] text-ink3 whitespace-nowrap hover:text-ink max-sm:text-xs {% if entry.url == page.url %}text-accent{% endif %}"
                                href="{{ entry.url }}"
                                {% if entry.url == page.url %}aria-current="page"{% endif %}
                                >{{ entry.title }}</a
                            >
                        {%- endfor %}
                        <button
                            id="theme-toggle"
                            class="-my-1.5 inline-flex cursor-pointer items-center gap-1.5 border border-line bg-transparent px-3 py-2.5 font-mono text-[11px] leading-none text-ink3 transition-[color,border-color,transform] duration-150 hover:text-ink hover:border-ink3 active:scale-[0.96]"
                            type="button"
                            aria-label="Toggle dark mode"
                            aria-pressed="false"
                        >
                            <svg class="icon-sun hidden h-3 w-3 dark:inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                            </svg>
                            <svg class="icon-moon h-3 w-3 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                            </svg>
                        </button>
                    </div>
                </nav>
            </header>

            <main id="main">{{ content | safe }}</main>

            <footer class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line py-7 font-mono text-[11px] text-ink3">
                <span>© {{ helpers.year() }} Jay Bell</span>
                <div class="flex flex-wrap items-center gap-5">
                    <a class="-my-2 py-2 text-ink3 hover:text-ink" href="https://github.com/yharaskrik" target="_blank" rel="noopener">GitHub</a>
                    <a class="-my-2 py-2 text-ink3 hover:text-ink" href="https://bsky.app/profile/jaycooperbell.dev" target="_blank" rel="noopener">Bluesky</a>
                    <a class="-my-2 py-2 text-ink3 hover:text-ink" href="https://www.linkedin.com/in/jay-bell-b7017681/" target="_blank" rel="noopener">LinkedIn</a>
                    <a class="-my-2 py-2 text-ink3 hover:text-ink" href="https://www.youtube.com/@jaybell7291" target="_blank" rel="noopener">YouTube</a>
                    <a class="-my-2 py-2 text-ink3 hover:text-ink" href="https://www.twitch.tv/yharaskrik" target="_blank" rel="noopener">Twitch</a>
                    <a class="-my-2 py-2 text-ink3 hover:text-ink" href="/feed.xml">RSS</a>
                </div>
                <span>
                    Built with <a class="text-ink3 hover:text-ink" href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a> · Design inspired by
                    <a class="text-ink3 hover:text-ink" href="https://muratkirazkaya.com/" target="_blank" rel="noopener">Murat Kirazkaya</a>
                </span>
            </footer>
        </div>

        <script>
            (function () {
                var toggle = document.getElementById('theme-toggle');
                var html = document.documentElement;
                function isDark() {
                    return html.classList.contains('dark');
                }
                function sync() {
                    var dark = isDark();
                    toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
                }
                sync();
                toggle.addEventListener('click', function () {
                    var dark = !isDark();
                    html.classList.add('theme-animating');
                    html.classList.toggle('dark', dark);
                    try {
                        localStorage.setItem('theme', dark ? 'dark' : 'light');
                    } catch (e) {}
                    sync();
                    window.setTimeout(function () {
                        html.classList.remove('theme-animating');
                    }, 300);
                });

                // Scroll reveals: elements marked data-reveal fade up as they enter
                var marked = document.querySelectorAll('[data-reveal]');
                if ('IntersectionObserver' in window && marked.length) {
                    var io = new IntersectionObserver(
                        function (entries) {
                            entries.forEach(function (entry) {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('revealed');
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
                    );
                    marked.forEach(function (el) {
                        io.observe(el);
                    });
                } else {
                    marked.forEach(function (el) {
                        el.classList.add('revealed');
                    });
                }
            })();
        </script>
    </body>
</html>
