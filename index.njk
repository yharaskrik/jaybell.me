<div class="sec-header" id="blog">
    <span class="sec-title">Blog</span>
    <div class="sec-line"></div>
</div>

<div class="blog-list">
    {% set posts = collections.posts | head(3) %}
    {% if posts.length %}
        {% for post in posts %}
            <a class="blog-teaser" href="{{ post.url }}">
                <div>
                    <div class="blog-teaser-eyebrow">{{ post.date | readableDate }}</div>
                    <div class="blog-teaser-title">{{ post.data.title }}</div>
                    {% if post.data.description %}
                        <div class="blog-teaser-sub">{{ post.data.description }}</div>
                    {% endif %}
                </div>
                <span class="blog-teaser-arrow">Read →</span>
            </a>
        {% endfor %}
        <a class="blog-teaser-more" href="/blog/">Browse the archive →</a>
    {% else %}
        <div class="blog-teaser">
            <div>
                <div class="blog-teaser-eyebrow">Coming soon</div>
                <div class="blog-teaser-title">First post is on its way</div>
                <div class="blog-teaser-sub">Check back soon for writing on Angular, Nx, open source, and startups.</div>
            </div>
        </div>
    {% endif %}
</div>
