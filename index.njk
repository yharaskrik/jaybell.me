            </div>
            <div class="proj-tags">
                <span class="tag">Startup</span>
                <span class="tag">Social Enterprise</span>
            </div>
        </div>
        <div class="proj-stat">
            <span class="proj-stat-label">Company</span>
            <a href="https://trellis.org/" target="_blank" rel="noreferrer noopener" class="proj-visit">trellis.org →</a>
