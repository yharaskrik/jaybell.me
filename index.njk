---
layout: base.njk
eleventyNavigation:
    key: Home
    order: 1
---

<section class="py-[72px] pb-[60px]">
    <div class="animate-rise mb-5 font-mono text-[11px] uppercase tracking-[0.1em] text-accent">
        CTO · Angular GDE · Nx Champion
    </div>
    <h1 class="animate-rise mb-7 font-display text-[clamp(38px,6vw,56px)] leading-[1.08] tracking-tight text-ink" style="--d: 70ms">
        I build software that<br />
        <em class="not-italic text-accent">makes a difference (and some just for fun).</em><br />
    </h1>
    <p class="animate-rise mb-10 max-w-[540px] text-base leading-[1.65] text-ink2" style="--d: 140ms">
        I'm Jay Bell - CTO &amp; Co-Founder of
        <a href="https://trellis.org/" target="_blank" rel="noreferrer noopener">Trellis.org</a>, a social
        enterprise empowering global collective impact. With over 10 years of experience steering Trellis's
        technical direction, I specialize in Nx, Angular, Nest, and DevOps.
    </p>
    <div class="animate-rise flex flex-wrap items-center gap-3.5" style="--d: 210ms">
        <a
            class="inline-block bg-ink px-6 py-3 font-mono text-xs tracking-[0.04em] text-surface transition-[background-color,color,transform] duration-150 hover:bg-accent hover:text-surface active:scale-[0.98]"
            href="/about/"
            >About me →</a
        >
        <a
            class="inline-block border border-line bg-transparent px-6 py-3 font-mono text-xs tracking-[0.04em] text-ink transition-[border-color,color,transform] duration-150 hover:border-ink3 hover:text-ink active:scale-[0.98]"
            href="https://github.com/yharaskrik"
            target="_blank"
            rel="noreferrer noopener"
            >GitHub / Open Source</a
        >
    </div>

    <div class="animate-rise mt-14 grid grid-cols-4 border border-line max-md:grid-cols-2" style="--d: 280ms">
        <div class="flex items-center gap-3 border-r border-line p-4 max-md:border-b">
            <img
                alt="Jay Bell"
                class="h-10 w-10 rounded-full border border-line object-cover"
                src="/assets/images/jay.jpg"
            />
            <div>
                <div class="text-sm font-medium text-ink">Jay Bell</div>
                <div class="font-mono text-[10px] text-ink3">CTO &amp; Co-Founder</div>
            </div>
        </div>
        <div class="border-r border-line p-4 max-md:border-b max-md:border-r-0">
            <div class="font-display text-2xl text-ink">50+</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.06em] text-ink3">podcast episodes</div>
        </div>
        <div class="border-r border-line p-4">
            <div class="font-display text-2xl text-ink">30+</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.06em] text-ink3">talks &amp; videos</div>
        </div>
        <div class="p-4">
            <div class="font-display text-2xl text-ink">10+ yrs</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.06em] text-ink3">shipping software</div>
        </div>
    </div>
</section>

<div class="flex items-baseline gap-4 pb-7 pt-12 scroll-mt-20" data-reveal id="things">
    <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink3">Things I'm up to</span>
    <div class="h-px flex-1 bg-line"></div>
</div>

<div class="grid grid-cols-2 gap-4 max-md:grid-cols-1">
    <div class="border border-line p-6" data-reveal>
        <div class="mb-4 flex items-center gap-5 max-sm:flex-col max-sm:items-start max-sm:gap-3">
            <img
                alt="The Angular Plus Show artwork"
                class="h-20 w-20 shrink-0 rounded-md border border-line object-cover"
                src="/assets/images/angular-plus-show.png"
            />
            <div>
                <div class="mb-1.5 font-mono text-[10px] tracking-[0.05em] text-accent">Podcast · ng-conf official</div>
                <div class="font-display text-2xl text-ink">The Angular Plus Show</div>
            </div>
        </div>
        <div class="mb-4 text-[13px] leading-[1.6] text-ink2">
            The home of ng-conf's official all-Angular podcast. Stay up to date on the latest in the
            Angular community, with bonus episodes from The Dev Life podcast.
        </div>
        <div class="mb-5 flex flex-wrap gap-1.5">
            <span class="pill">Angular</span>
            <span class="pill">ng-conf</span>
            <span class="pill">Podcast</span>
        </div>
        <a
            class="-my-2 inline-block py-2 font-mono text-[11px] tracking-[0.03em] text-ink3 transition-transform duration-150 hover:translate-x-0.5 hover:text-accent"
            href="/podcast/"
            >Listen to episodes →</a
        >
    </div>

    <div class="border border-line p-6" data-reveal style="--rd: 60ms">
        <div class="mb-4">
            <div class="mb-1.5 font-mono text-[10px] tracking-[0.05em] text-accent">Work · since 2018</div>
            <div class="font-display text-2xl text-ink">Trellis</div>
        </div>
        <div class="mb-4 text-[13px] leading-[1.6] text-ink2">
            Building software that has to hold up when it matters most - empowering global collective
            impact for charities and their donors.
        </div>
        <div class="mb-5 flex flex-wrap gap-1.5">
            <span class="pill">Startup</span>
            <span class="pill">Social Enterprise</span>
        </div>
        <div class="flex flex-wrap items-center gap-4">
            <a
                class="-my-2 inline-block py-2 font-mono text-[11px] tracking-[0.03em] text-ink3 transition-transform duration-150 hover:translate-x-0.5 hover:text-accent"
                href="https://trellis.org/"
                target="_blank"
                rel="noreferrer noopener"
                >trellis.org →</a
            >
            <a
                class="-my-2 inline-block py-2 font-mono text-[11px] tracking-[0.03em] text-ink3 transition-transform duration-150 hover:translate-x-0.5 hover:text-accent"
                href="https://tech.trellis.org"
                target="_blank"
                rel="noreferrer noopener"
                >Tech blog →</a
            >
        </div>
    </div>
</div>

<div class="mt-4 flex flex-col border-t border-line">
    <div class="grid grid-cols-[1fr_auto] items-start gap-6 border-b border-line py-6 max-sm:grid-cols-1" data-reveal>
        <div>
            <div class="mb-2 font-mono text-[10px] tracking-[0.05em] text-ink3">Hobby</div>
            <div class="mb-2 font-display text-xl text-ink">Horde 40k</div>
            <div class="mb-3 max-w-[480px] text-[13px] leading-[1.6] text-ink2">
                A Warhammer 40k companion app built with Angular and Nx - my playground for big-monorepo
                architecture, performance, and modern Angular.
            </div>
            <div class="flex flex-wrap gap-1.5">
                <span class="pill">Angular</span>
                <span class="pill">Nx</span>
                <span class="pill">Warhammer 40k</span>
            </div>
        </div>
        <div class="min-w-[120px] pr-4 text-right max-sm:pr-0 max-sm:text-left">
            <a class="mt-1 -my-2 block py-2 font-mono text-[10px] tracking-[0.03em] text-ink3 transition-transform duration-150 hover:translate-x-0.5 hover:text-accent" href="https://horde-40k.web.app" target="_blank" rel="noreferrer noopener">Horde →</a>
        </div>
    </div>

    <div class="grid grid-cols-[1fr_auto] items-start gap-6 border-b border-line py-6 max-sm:grid-cols-1" data-reveal style="--rd: 40ms">
        <div>
            <div class="mb-2 font-mono text-[10px] tracking-[0.05em] text-ink3">Community</div>
            <div class="mb-2 font-display text-xl text-ink">Angular GDE &amp; Nx Champion</div>
            <div class="mb-3 max-w-[480px] text-[13px] leading-[1.6] text-ink2">
                I help grow the Angular and Nx communities through talks, streams, open source, and
                mentoring. Check my contributions on GitHub.
            </div>
            <div class="flex flex-wrap gap-1.5">
                <span class="pill">Angular</span>
                <span class="pill">Nx</span>
                <span class="pill">Community</span>
            </div>
        </div>
        <div class="min-w-[120px] pr-4 text-right max-sm:pr-0 max-sm:text-left">
            <a class="mt-1 -my-2 block py-2 font-mono text-[10px] tracking-[0.03em] text-ink3 transition-transform duration-150 hover:translate-x-0.5 hover:text-accent" href="https://developers.google.com/profile/u/jaycooperbell" target="_blank" rel="noreferrer noopener">Google →</a>
        </div>
    </div>

    <div class="grid grid-cols-[1fr_auto] items-start gap-6 border-b border-line py-6 max-sm:grid-cols-1" data-reveal style="--rd: 80ms">
        <div>
            <div class="mb-2 font-mono text-[10px] tracking-[0.05em] text-ink3">Show</div>
            <div class="mb-2 font-display text-xl text-ink">This is Tech Talks</div>
            <div class="mb-3 max-w-[480px] text-[13px] leading-[1.6] text-ink2">
                A show about tech, software, and the people building it - watch the streams I've been a
                part of on YouTube.
            </div>
            <div class="flex flex-wrap gap-1.5">
                <span class="pill">Tech</span>
                <span class="pill">Talks</span>
                <span class="pill">YouTube</span>
            </div>
        </div>
        <div class="min-w-[120px] pr-4 text-right max-sm:pr-0 max-sm:text-left">
            <a class="mt-1 -my-2 block py-2 font-mono text-[10px] tracking-[0.03em] text-ink3 transition-transform duration-150 hover:translate-x-0.5 hover:text-accent" href="https://www.youtube.com/@jaybell7291" target="_blank" rel="noreferrer noopener">YouTube →</a>
        </div>
    </div>
</div>

<div class="flex items-baseline gap-4 pb-7 pt-12 scroll-mt-20" data-reveal id="blog">
    <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink3">Blog</span>
    <div class="h-px flex-1 bg-line"></div>
</div>

<div class="mt-5 flex flex-col gap-2.5">
    {% set posts = collections.posts | head(3) %}
    {% if posts.length %}
        {% for post in posts %}
            <a
                class="group flex flex-wrap items-center justify-between gap-6 border border-line border-l-[3px] border-l-accent bg-surface p-[26px_30px] text-inherit no-underline transition-[background,border-color] duration-150 hover:bg-surface2 hover:border-ink3"
                data-reveal
                href="{{ post.url }}"
            >
                <div>
                    <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.08em] text-accent">{{ post.date | readableDate }}</div>
                    <div class="mb-1.5 max-w-[520px] font-display text-[clamp(20px,3.5vw,26px)] leading-[1.18] text-ink">{{ post.data.title }}</div>
                    {% if post.data.description %}
                        <div class="max-w-[520px] text-[13px] leading-[1.55] text-ink3">{{ post.data.description }}</div>
                    {% endif %}
                </div>
                <span class="flex-shrink-0 font-mono text-xs tracking-[0.04em] text-accent transition-[transform,color] duration-150 group-hover:translate-x-1 hover:translate-x-1 hover:text-ink">Read →</span>
            </a>
        {% endfor %}
        <a class="mt-4 -my-2 block py-2 text-right font-mono text-[11px] tracking-[0.04em] text-ink3 hover:text-accent" href="/blog/">Browse the full stream →</a>
    {% else %}
        <div class="flex flex-wrap items-center justify-between gap-6 border border-line border-l-[3px] border-l-accent bg-surface p-[26px_30px]">
            <div>
                <div class="mb-2 font-mono text-[10px] uppercase tracking-[0.08em] text-accent">Coming soon</div>
                <div class="mb-1.5 max-w-[520px] font-display text-[clamp(20px,3.5vw,26px)] leading-[1.18] text-ink">First post is on its way</div>
                <div class="max-w-[520px] text-[13px] leading-[1.55] text-ink3">Check back soon for writing on Angular, Nx, open source, and startups.</div>
            </div>
        </div>
    {% endif %}
</div>
