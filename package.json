{
    "name": "jaybellme",
    "version": "3.0.0",
    "description": "Jay Cooper Bell's personal site and blog - Built with Eleventy",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "eleventy",
        "build:ghpages": "eleventy --pathprefix=/",
        "start": "eleventy --serve --quiet",
        "dev": "eleventy --serve --quiet",
        "serve": "eleventy --serve",
        "debug": "DEBUG=Eleventy* eleventy",
        "debugstart": "DEBUG=Eleventy* eleventy --serve --quiet",
        "benchmark": "DEBUG=Eleventy:Benchmark* eleventy",
        "deploy": "npm run build && gh-pages -d _site",
        "css": "tailwindcss -i ./styles/main.css -o ./gen/main.css",
        "format": "nx format:write",
        "format:check": "nx format:check"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/yharaskrik/jaybell.me.git"
    },
    "author": {
        "name": "Jay Bell",
        "email": "jay@jaybell.me",
        "url": "https://jaybell.me/"
    },
    "license": "MIT",
    "homepage": "https://jaybell.me/",
    "devDependencies": {
        "@11ty/eleventy": "3.1.5",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-rss": "3.0.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
        "@quasibit/eleventy-plugin-sitemap": "2.2.0",
        "@tailwindcss/cli": "^4.1.0",
        "@tailwindcss/typography": "^0.5.20",
        "gh-pages": "^6.3.0",
        "luxon": "^3.7.1",
        "nx": "23.1.1",
        "prettier": "^3.6.2",
        "prettier-plugin-nunjucks": "^0.1.5",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.1.0"
    },
    "nx": {}
}
