{
    "name": "jaybellme",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=18.13.0"
    },
    "scripts": {
        "dev": "npm run svg && nx serve",
        "ng": "ng",
        "start": "npm run dev",
        "build": "npm run svg && nx build",
        "watch": "nx build --watch",
        "test": "nx test",
        "preview": "npm run build && wrangler pages dev",
        "deploy": "npm run build && wrangler pages deploy",
        "cf-typegen": "wrangler types",
        "svg": "svg-generator"
    },
    "svgGenerator": {
        "outputPath": "./src/app/svg/",
        "srcPath": "./src/public/assets/",
        "svgoConfig": {
            "plugins": [
                "removeDimensions",
                "cleanupAttrs",
                {
                    "name": "convertColors",
                    "params": {
                        "currentColor": true
                    }
                }
            ]
        }
    },
    "dependencies": {
        "@analogjs/content": "^1.2.0",
        "@analogjs/router": "^1.2.0",
        "@angular/animations": "^17.3.5",
        "@angular/cdk": "~17.3.5",
        "@angular/common": "^17.3.5",
        "@angular/compiler": "^17.3.5",
        "@angular/core": "^17.3.5",
        "@angular/forms": "^17.3.5",
        "@angular/material": "^17.3.5",
        "@angular/platform-browser": "^17.3.5",
        "@angular/platform-browser-dynamic": "^17.3.5",
        "@angular/platform-server": "^17.3.5",
        "@angular/router": "^17.3.5",
        "@ngneat/svg-icon": "^7.1.0",
        "front-matter": "^4.0.2",
        "marked": "^5.0.2",
        "marked-gfm-heading-id": "^3.1.0",
        "marked-highlight": "^2.0.1",
        "mermaid": "^10.2.4",
        "ngx-device-detector": "^7.0.0",
        "prismjs": "^1.29.0",
        "rxjs": "~7.5.6",
        "tslib": "^2.4.0",
        "zone.js": "~0.14.0"
    },
    "devDependencies": {
        "@analogjs/platform": "^1.2.0",
        "@analogjs/vite-plugin-angular": "^1.2.0",
        "@angular-devkit/core": "^17.3.5",
        "@angular-devkit/schematics": "^17.3.5",
        "@angular/cli": "^17.3.5",
        "@angular/compiler-cli": "^17.3.5",
        "@cloudflare/workers-types": "^4.20240419.0",
        "@ngneat/svg-generator": "^7.0.3",
        "@nx/angular": "18.3.3",
        "@nx/vite": "18.3.3",
        "@nx/workspace": "18.3.3",
        "@schematics/angular": "^17.3.5",
        "@tailwindcss/typography": "^0.5.12",
        "autoprefixer": "^10.4.19",
        "daisyui": "^3.9.4",
        "jsdom": "^22.1.0",
        "nx": "18.3.3",
        "postcss": "^8.4.27",
        "postcss-nesting": "^12.0.1",
        "prettier": "^3.2.5",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-organize-imports": "^3.2.4",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "tailwindcss": "^3.4.3",
        "typescript": "~5.4.5",
        "vite": "^5.2.10",
        "vitest": "^1.4.0",
        "wrangler": "^3.51.2"
    }
}
